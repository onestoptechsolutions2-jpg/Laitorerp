@page
@using Microsoft.AspNetCore.Mvc.Localization
@using Leitor.Erp.Localization
@using Leitor.Erp.Entities.Governance
@inject IHtmlLocalizer<ErpResource> L
@model Leitor.Erp.Pages.Changes.DetailModel

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="card-title mb-0"><span class="doc-no">@Model.Change.ChangeNumber</span> - @Model.Change.Title</h5>
        <div>
            @if (Model.Change.Status == ChangeRequestStatus.PendingApproval && Model.CanApprove)
            {
                <form method="post" asp-page-handler="Approve" class="d-inline" onsubmit="return confirm('@L["ApproveChange"]?');">
                    <button type="submit" class="btn btn-success">@L["Approve"]</button>
                </form>
                <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#rejectModal">@L["Reject"]</button>
            }
            @if (Model.Change.Status == ChangeRequestStatus.Approved && Model.CanEdit)
            {
                <form method="post" asp-page-handler="Complete" class="d-inline" onsubmit="return confirm('@L["MarkComplete"]?');">
                    <button type="submit" class="btn btn-primary">@L["MarkComplete"]</button>
                </form>
            }
            @if (Model.Change.Status == ChangeRequestStatus.Completed && Model.CanEdit)
            {
                <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#rollbackModal">@L["RecordRollback"]</button>
            }
            @if (Model.Change.Tier == ChangeTier.Emergency && Model.Change.PostImplementationReviewedDate == null && Model.CanApprove)
            {
                <form method="post" asp-page-handler="ReviewPostImplementation" class="d-inline">
                    <button type="submit" class="btn btn-outline-warning">@L["MarkReviewed"]</button>
                </form>
            }
            <a asp-page="./Index" class="btn btn-secondary">@L["BackToList"]</a>
        </div>
    </div>
    <div class="card-body">
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger">@Model.ErrorMessage</div>
        }
        @if (Model.Change.Tier == ChangeTier.Emergency && Model.Change.PostImplementationReviewedDate == null)
        {
            <div class="alert alert-warning">@L["EmergencyChangeNeedsReview"]</div>
        }
        <dl class="row mb-0">
            <dt class="col-sm-2">@L["ConfigurationItem"]</dt>
            <dd class="col-sm-4"><a asp-page="/Assets/Detail" asp-route-id="@Model.Change.ConfigurationItemId">@Model.Change.ConfigurationItemName</a></dd>
            <dt class="col-sm-2">@L["Tier"]</dt>
            <dd class="col-sm-4">@L[$"Enum:ChangeTier:{(int)Model.Change.Tier}"]</dd>

            <dt class="col-sm-2">@L["Status"]</dt>
            <dd class="col-sm-4"><span class="pill @StatusPill.For(Model.Change.Status)">@L[$"Enum:ChangeRequestStatus:{(int)Model.Change.Status}"]</span></dd>
            <dt class="col-sm-2">@L["PlannedDate"]</dt>
            <dd class="col-sm-4">@(Model.Change.PlannedDate?.ToShortDateString() ?? "-")</dd>

            @if (!string.IsNullOrWhiteSpace(Model.TicketNumber))
            {
                <dt class="col-sm-2">@L["Ticket"]</dt>
                <dd class="col-sm-10"><a asp-page="/Support/Tickets/Detail" asp-route-id="@Model.Change.TicketId">@Model.TicketNumber</a></dd>
            }

            @if (!string.IsNullOrWhiteSpace(Model.Change.Description))
            {
                <dt class="col-sm-2">@L["Description"]</dt>
                <dd class="col-sm-10">@Model.Change.Description</dd>
            }

            @if (Model.Change.ApprovedByUserId.HasValue)
            {
                <dt class="col-sm-2">@L["ApprovedBy"]</dt>
                <dd class="col-sm-4">@Model.Change.ApprovedByUserName (@Model.Change.ApprovedDate?.ToShortDateString())</dd>
            }

            @if (!string.IsNullOrWhiteSpace(Model.Change.RejectionReason))
            {
                <dt class="col-sm-2">@L["RejectionReason"]</dt>
                <dd class="col-sm-10">@Model.Change.RejectionReason</dd>
            }

            @if (Model.Change.CompletedDate.HasValue)
            {
                <dt class="col-sm-2">@L["CompletedDate"]</dt>
                <dd class="col-sm-4">@Model.Change.CompletedDate?.ToShortDateString()</dd>
            }

            @if (Model.Change.RolledBack)
            {
                <dt class="col-sm-2">@L["RollbackNotes"]</dt>
                <dd class="col-sm-10">@Model.Change.RollbackNotes</dd>
            }

            @if (Model.Change.PostImplementationReviewedDate.HasValue)
            {
                <dt class="col-sm-2">@L["ReviewedDate"]</dt>
                <dd class="col-sm-4">@Model.Change.PostImplementationReviewedDate?.ToShortDateString()</dd>
            }
        </dl>
    </div>
</div>

<!-- Reject Modal -->
<div class="modal fade" id="rejectModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@L["Reject"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="Reject">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">@L["RejectionReason"]</label>
                        <textarea class="form-control" name="reason" required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@L["Cancel"]</button>
                    <button type="submit" class="btn btn-danger">@L["Reject"]</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Rollback Modal -->
<div class="modal fade" id="rollbackModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@L["RecordRollback"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="RollBack">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">@L["RollbackNotes"]</label>
                        <textarea class="form-control" name="notes" required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@L["Cancel"]</button>
                    <button type="submit" class="btn btn-danger">@L["RecordRollback"]</button>
                </div>
            </form>
        </div>
    </div>
</div>
