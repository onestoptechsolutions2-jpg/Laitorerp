@page "{id}"
@using Microsoft.AspNetCore.Mvc.Localization
@using Leitor.Erp.Localization
@using Leitor.Erp.Entities.Hr
@inject IHtmlLocalizer<ErpResource> L
@model Leitor.Erp.Pages.Hr.LeaveRequests.DetailModel

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="card-title mb-0">@L["LeaveRequest"] - @Model.EmployeeName</h5>
        <a asp-page="./Index" class="btn btn-secondary">@L["BackToList"]</a>
    </div>
    <div class="card-body">
        <partial name="/Pages/Shared/_PendingEscalationBanner.cshtml" model="Model.HasPendingApprovalEscalation" />
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-info">@Model.ErrorMessage</div>
        }
        <dl class="row mb-0">
            <dt class="col-sm-2">@L["Status"]</dt>
            <dd class="col-sm-4"><span class="pill @StatusPill.For(Model.LeaveRequest.Status)">@L[$"Enum:LeaveRequestStatus:{(int)Model.LeaveRequest.Status}"]</span></dd>
            <dt class="col-sm-2">@L["Type"]</dt>
            <dd class="col-sm-4">@L[$"Enum:LeaveType:{(int)Model.LeaveRequest.LeaveType}"]</dd>

            <dt class="col-sm-2">@L["StartDate"]</dt>
            <dd class="col-sm-4">@Model.LeaveRequest.StartDate.ToShortDateString()</dd>
            <dt class="col-sm-2">@L["EndDate"]</dt>
            <dd class="col-sm-4">@Model.LeaveRequest.EndDate.ToShortDateString()</dd>

            <dt class="col-sm-2">@L["Days"]</dt>
            <dd class="col-sm-4">@Model.LeaveRequest.DaysRequested</dd>

            @if (!string.IsNullOrWhiteSpace(Model.LeaveRequest.Reason))
            {
                <dt class="col-sm-2">@L["Reason"]</dt>
                <dd class="col-sm-10">@Model.LeaveRequest.Reason</dd>
            }
        </dl>

        @if (Model.CanEdit && Model.LeaveRequest.Status == LeaveRequestStatus.Draft)
        {
            <form method="post" asp-page-handler="Submit" class="mt-3">
                <button type="submit" class="btn btn-primary">@L["SubmitForApproval"]</button>
                <a asp-page="./Edit" asp-route-id="@Model.LeaveRequest.Id" class="btn btn-outline-primary" data-overlay data-overlay-title="@L["EditLeaveRequest"]">@L["Edit"]</a>
            </form>
        }

        @if (Model.LeaveRequest.Status == LeaveRequestStatus.PendingApproval && Model.HasPendingApprovalEscalation)
        {
            <a asp-page="/Governance/Escalations/Index" class="btn btn-outline-secondary mt-3">@L["ViewInEscalationsQueue"]</a>
        }
    </div>
</div>
