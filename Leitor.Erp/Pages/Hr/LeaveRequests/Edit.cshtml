@page "{id}"
@using Microsoft.AspNetCore.Mvc.Localization
@using Leitor.Erp.Localization
@inject IHtmlLocalizer<ErpResource> L
@model Leitor.Erp.Pages.Hr.LeaveRequests.EditModel
@{
    if (OverlayRequest.Is(Request)) { Layout = null; }
}

<div class="card">
    <div class="card-header">
        <h5 class="card-title mb-0">@L["EditLeaveRequest"]</h5>
    </div>
    <div class="card-body">
        <form method="post">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="All" class="text-danger"></div>
            <abp-select asp-for="LeaveRequest.EmployeeId" asp-items="Model.EmployeeOptions" label="@L["Employee"].Value" />
            <div class="mb-3">
                <label class="form-label">@L["Type"]</label>
                <select asp-for="LeaveRequest.LeaveType" class="form-select">
                    <option value="0">@L["Enum:LeaveType:0"]</option>
                    <option value="1">@L["Enum:LeaveType:1"]</option>
                    <option value="2">@L["Enum:LeaveType:2"]</option>
                    <option value="3">@L["Enum:LeaveType:3"]</option>
                    <option value="4">@L["Enum:LeaveType:4"]</option>
                    <option value="5">@L["Enum:LeaveType:5"]</option>
                    <option value="6">@L["Enum:LeaveType:6"]</option>
                </select>
            </div>
            <abp-input asp-for="LeaveRequest.StartDate" />
            <abp-input asp-for="LeaveRequest.EndDate" />
            <abp-input asp-for="LeaveRequest.DaysRequested" />
            <abp-input asp-for="LeaveRequest.Reason" />

            <div class="mt-3">
                <button type="submit" class="btn btn-primary">@L["Save"]</button>
                <a asp-page="./Detail" asp-route-id="@Model.Id" class="btn btn-secondary">@L["Cancel"]</a>
            </div>
        </form>
    </div>
</div>
