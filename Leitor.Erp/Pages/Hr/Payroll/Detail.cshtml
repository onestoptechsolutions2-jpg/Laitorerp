@page "{id}"
@using Microsoft.AspNetCore.Mvc.Localization
@using Leitor.Erp.Localization
@using Leitor.Erp.Entities.Hr
@inject IHtmlLocalizer<ErpResource> L
@model Leitor.Erp.Pages.Hr.Payroll.DetailModel

<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="card-title mb-0">@L["Payroll"] - @Model.Run.PeriodStart.ToShortDateString() - @Model.Run.PeriodEnd.ToShortDateString()</h5>
        <a asp-page="./Index" class="btn btn-secondary">@L["BackToList"]</a>
    </div>
    <div class="card-body">
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger">@Model.ErrorMessage</div>
        }
        <dl class="row mb-0">
            <dt class="col-sm-2">@L["Status"]</dt>
            <dd class="col-sm-4"><span class="pill @(Model.Run.Status == PayrollRunStatus.Posted ? "pill-success" : "pill-neutral")">@L[$"Enum:PayrollRunStatus:{(int)Model.Run.Status}"]</span></dd>
            <dt class="col-sm-2">@L["Employees"]</dt>
            <dd class="col-sm-4">@Model.Run.EmployeeCount</dd>

            <dt class="col-sm-2">@L["TotalNetPay"]</dt>
            <dd class="col-sm-4">@Model.Run.TotalNetPay.ToString("N2")</dd>
            @if (Model.Run.RunAt.HasValue)
            {
                <dt class="col-sm-2">@L["PostedBy"]</dt>
                <dd class="col-sm-4">@Model.Run.RunByUserName @L["On"] @Model.Run.RunAt.Value.ToString("g")</dd>
            }
        </dl>

        @if (Model.CanRun && Model.Run.Status == PayrollRunStatus.Draft)
        {
            <form method="post" asp-page-handler="Post" class="mt-3" onsubmit="return confirm('@L["ConfirmPostPayroll"]');">
                <button type="submit" class="btn btn-primary">@L["PostToLedger"]</button>
            </form>
        }
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h5 class="card-title mb-0">@L["PayrollLines"]</h5>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-sm table-striped">
                <thead>
                    <tr>
                        <th>@L["Employee"]</th>
                        <th>@L["GrossPay"]</th>
                        <th>@L["Paye"]</th>
                        <th>@L["NssfEmployee"]</th>
                        <th>@L["ShaContribution"]</th>
                        <th>@L["HousingLevyEmployee"]</th>
                        <th>@L["NetPay"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var line in Model.Run.Lines)
                    {
                        <tr>
                            <td>@line.EmployeeName</td>
                            <td>@line.GrossPay.ToString("N2")</td>
                            <td>@line.Paye.ToString("N2")</td>
                            <td>@line.NssfEmployee.ToString("N2")</td>
                            <td>@line.ShaContribution.ToString("N2")</td>
                            <td>@line.HousingLevyEmployee.ToString("N2")</td>
                            <td>@line.NetPay.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
