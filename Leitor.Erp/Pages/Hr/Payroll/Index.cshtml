@page
@using Microsoft.AspNetCore.Mvc.Localization
@using Leitor.Erp.Localization
@inject IHtmlLocalizer<ErpResource> L
@model Leitor.Erp.Pages.Hr.Payroll.IndexModel

<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="card-title mb-0">@L["Payroll"]</h5>
        @if (Model.CanManageRates)
        {
            <a asp-page="./TaxBands/Index" class="btn btn-outline-secondary btn-sm">@L["TaxBands"]</a>
        }
    </div>
    <div class="card-body">
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger">@Model.ErrorMessage</div>
        }
        @if (Model.CanRun)
        {
            <form method="post" asp-page-handler="Run" class="row g-2 mb-3">
                <div class="col-auto">
                    <label class="form-label">@L["PeriodStart"]</label>
                    <input type="date" asp-for="PeriodStart" class="form-control" />
                </div>
                <div class="col-auto">
                    <label class="form-label">@L["PeriodEnd"]</label>
                    <input type="date" asp-for="PeriodEnd" class="form-control" />
                </div>
                <div class="col-auto align-self-end">
                    <button type="submit" class="btn btn-primary">@L["RunPayroll"]</button>
                </div>
            </form>
        }
        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>@L["PeriodStart"]</th>
                        <th>@L["PeriodEnd"]</th>
                        <th>@L["Status"]</th>
                        <th>@L["Employees"]</th>
                        <th>@L["TotalNetPay"]</th>
                        <th>@L["Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Runs.Any())
                    {
                        <tr class="table-empty-state"><td colspan="6">@L["NoResultsFound"]</td></tr>
                    }
                    @foreach (var run in Model.Runs)
                    {
                        <tr>
                            <td>@run.PeriodStart.ToShortDateString()</td>
                            <td>@run.PeriodEnd.ToShortDateString()</td>
                            <td><span class="pill @(run.Status == Leitor.Erp.Entities.Hr.PayrollRunStatus.Posted ? "pill-success" : "pill-neutral")">@L[$"Enum:PayrollRunStatus:{(int)run.Status}"]</span></td>
                            <td>@run.EmployeeCount</td>
                            <td>@run.TotalNetPay.ToString("N2")</td>
                            <td><a asp-page="./Detail" asp-route-id="@run.Id" class="btn btn-sm btn-outline-secondary">@L["View"]</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="/Pages/Shared/_Pagination.cshtml" model="Model.Pagination" />
    </div>
</div>
