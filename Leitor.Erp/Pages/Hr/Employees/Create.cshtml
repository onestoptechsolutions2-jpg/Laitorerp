@page
@using Microsoft.AspNetCore.Mvc.Localization
@using Leitor.Erp.Localization
@inject IHtmlLocalizer<ErpResource> L
@model Leitor.Erp.Pages.Hr.Employees.CreateModel
@{
    if (OverlayRequest.Is(Request)) { Layout = null; }
}

<div class="card">
    <div class="card-header">
        <h5 class="card-title mb-0">@L["NewEmployee"]</h5>
    </div>
    <div class="card-body">
        <form method="post">
            <div asp-validation-summary="All" class="text-danger"></div>
            <abp-input asp-for="Employee.FullName" />
            <abp-input asp-for="Employee.Email" />
            <abp-input asp-for="Employee.Phone" />
            <abp-input asp-for="Employee.JobTitle" />
            <abp-input asp-for="Employee.Department" />
            <abp-input asp-for="Employee.HireDate" />
            <abp-input asp-for="Employee.IsActive" />
            <abp-input asp-for="Employee.KraPin" />
            <abp-input asp-for="Employee.NssfNumber" />
            <abp-input asp-for="Employee.ShaNumber" />
            <abp-input asp-for="Employee.BasicSalary" />
            <abp-input asp-for="Employee.BankName" />
            <abp-input asp-for="Employee.BankAccountNumber" />

            <div class="mt-3">
                <button type="submit" class="btn btn-primary">@L["Save"]</button>
                <a asp-page="./Index" class="btn btn-secondary">@L["Cancel"]</a>
            </div>
        </form>
    </div>
</div>
