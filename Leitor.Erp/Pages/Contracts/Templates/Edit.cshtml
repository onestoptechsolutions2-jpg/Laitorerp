@page "{id}"
@using Microsoft.AspNetCore.Mvc.Localization
@using Leitor.Erp.Localization
@inject IHtmlLocalizer<ErpResource> L
@model Leitor.Erp.Pages.Contracts.Templates.EditModel
@{
    if (OverlayRequest.Is(Request)) { Layout = null; }
}

<div class="card">
    <div class="card-header">
        <h5 class="card-title mb-0">@L["EditContractTemplate"]</h5>
    </div>
    <div class="card-body">
        <form method="post">
            <div asp-validation-summary="All" class="text-danger"></div>
            <abp-input asp-for="Template.Name" />
            <div class="row">
                <div class="col-md-4"><abp-input asp-for="Template.DefaultTermMonths" /></div>
                <div class="col-md-4"><abp-input asp-for="Template.IsActive" /></div>
            </div>

            <div class="alert alert-info small mt-3">
                <strong>@L["Placeholders"]:</strong>
                [ClientName], [ClientAddress], [StartDate], [EndDate], [AgreementDate], [ContractNumber],
                [Purpose], [TermMonths], [AnnualFee], [VatAmount], [TotalAmount], [CompanyName],
                [CompanyAddress], [CompanySignatoryName], [ClientSignatoryName]
            </div>

            <h6 class="mt-3">@L["Sections"]</h6>
            <p class="text-muted small">@L["ContractTemplateSectionsHint"]</p>
            @for (var i = 0; i < Model.Template.Sections.Count; i++)
            {
                <div class="border rounded p-2 mb-2">
                    <input asp-for="Template.Sections[i].Heading" class="form-control form-control-sm mb-1" placeholder="@L["Heading"]" />
                    <textarea asp-for="Template.Sections[i].BodyText" class="form-control form-control-sm" rows="4" placeholder="@L["BodyText"]"></textarea>
                </div>
            }

            <div class="mt-3">
                <button type="submit" class="btn btn-primary">@L["Save"]</button>
                <a asp-page="./Index" class="btn btn-secondary">@L["Cancel"]</a>
            </div>
        </form>
    </div>
</div>
