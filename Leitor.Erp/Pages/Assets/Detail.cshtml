@page "{id}"
@using Microsoft.AspNetCore.Mvc.Localization
@using Leitor.Erp.Localization
@inject IHtmlLocalizer<ErpResource> L
@model Leitor.Erp.Pages.Assets.DetailModel

<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="card-title mb-0">@Model.Item.Name</h5>
        <div>
            @if (Model.CanEdit)
            {
                <a asp-page="./Edit" asp-route-id="@Model.Item.Id" class="btn btn-outline-primary">@L["Edit"]</a>
            }
            <a asp-page="./Index" class="btn btn-secondary">@L["BackToList"]</a>
        </div>
    </div>
    <div class="card-body">
        <partial name="/Pages/Shared/_PendingDeletionBanner.cshtml" model="Model.HasPendingDeletionRequest" />
        <dl class="row mb-0">
            <dt class="col-sm-2">@L["CIType"]</dt>
            <dd class="col-sm-4">@L[$"Enum:ConfigurationItemType:{(int)Model.Item.CIType}"]</dd>
            <dt class="col-sm-2">@L["Status"]</dt>
            <dd class="col-sm-4"><span class="pill @StatusPill.For(Model.Item.Status)">@L[$"Enum:ConfigurationItemStatus:{(int)Model.Item.Status}"]</span></dd>

            @if (!string.IsNullOrWhiteSpace(Model.Item.CustomerName))
            {
                <dt class="col-sm-2">@L["Customer"]</dt>
                <dd class="col-sm-4"><a asp-page="/Customers/Detail" asp-route-id="@Model.Item.CustomerId">@Model.Item.CustomerName</a></dd>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Item.SerialNumber))
            {
                <dt class="col-sm-2">@L["SerialNumber"]</dt>
                <dd class="col-sm-4">@Model.Item.SerialNumber</dd>
            }

            @if (Model.Item.PurchaseDate.HasValue)
            {
                <dt class="col-sm-2">@L["PurchaseDate"]</dt>
                <dd class="col-sm-4">@Model.Item.PurchaseDate.Value.ToShortDateString()</dd>
            }
            @if (Model.Item.WarrantyExpiryDate.HasValue)
            {
                <dt class="col-sm-2">@L["WarrantyExpiryDate"]</dt>
                <dd class="col-sm-4">@Model.Item.WarrantyExpiryDate.Value.ToShortDateString()</dd>
            }

            @if (!string.IsNullOrWhiteSpace(Model.Item.Notes))
            {
                <dt class="col-sm-2">@L["Notes"]</dt>
                <dd class="col-sm-10">@Model.Item.Notes</dd>
            }
        </dl>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header">
        <h5 class="card-title mb-0">@L["SecurityStatus"]</h5>
    </div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-2">@L["HasEndpointProtection"]</dt>
            <dd class="col-sm-4"><span class="pill @(Model.Item.HasEndpointProtection ? "pill-success" : "pill-danger")">@(Model.Item.HasEndpointProtection ? L["Yes"] : L["No"])</span></dd>
            <dt class="col-sm-2">@L["SecurityMonitoringEnabled"]</dt>
            <dd class="col-sm-4"><span class="pill @(Model.Item.SecurityMonitoringEnabled ? "pill-success" : "pill-danger")">@(Model.Item.SecurityMonitoringEnabled ? L["Yes"] : L["No"])</span></dd>

            <dt class="col-sm-2">@L["IsBackedUp"]</dt>
            <dd class="col-sm-4"><span class="pill @(Model.Item.IsBackedUp ? "pill-success" : "pill-danger")">@(Model.Item.IsBackedUp ? L["Yes"] : L["No"])</span></dd>
            <dt class="col-sm-2">@L["LastBackupVerifiedDate"]</dt>
            <dd class="col-sm-4">@(Model.Item.LastBackupVerifiedDate?.ToShortDateString())</dd>

            <dt class="col-sm-2">@L["LastPatchedDate"]</dt>
            <dd class="col-sm-4">@(Model.Item.LastPatchedDate?.ToShortDateString())</dd>
        </dl>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header">
        <h5 class="card-title mb-0">@L["Credentials"]</h5>
    </div>
    <div class="card-body">
        @if (Model.CanEdit)
        {
            <form method="post" asp-page-handler="AddCredential" class="row g-2 mb-3 align-items-end">
                <div class="col-md-2">
                    <label class="form-label">@L["Label"]</label>
                    <input asp-for="NewCredential.Label" class="form-control" required />
                </div>
                <div class="col-md-2">
                    <label class="form-label">@L["CredentialType"]</label>
                    <select asp-for="NewCredential.CredentialType" class="form-select">
                        <option value="0">@L["Enum:AssetCredentialType:0"]</option>
                        <option value="1">@L["Enum:AssetCredentialType:1"]</option>
                        <option value="2">@L["Enum:AssetCredentialType:2"]</option>
                        <option value="3">@L["Enum:AssetCredentialType:3"]</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">@L["Username"]</label>
                    <input asp-for="NewCredential.Username" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">@L["Value"]</label>
                    <input asp-for="NewCredential.Value" type="password" class="form-control" autocomplete="new-password" required />
                </div>
                <div class="col-md-2">
                    <label class="form-label">@L["Notes"]</label>
                    <input asp-for="NewCredential.Notes" class="form-control" />
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary">@L["AddCredential"]</button>
                </div>
            </form>
        }
        <div class="table-responsive">
            <table class="table table-sm mb-0">
                <thead>
                    <tr>
                        <th>@L["Label"]</th>
                        <th>@L["CredentialType"]</th>
                        <th>@L["Username"]</th>
                        <th>@L["Value"]</th>
                        <th>@L["Notes"]</th>
                        <th>@L["Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Credentials.Any())
                    {
                        <tr class="table-empty-state"><td colspan="6">@L["NoResultsFound"]</td></tr>
                    }
                    @foreach (var credential in Model.Credentials)
                    {
                        <tr data-credential-row="@credential.Id">
                            <td>@credential.Label</td>
                            <td>@L[$"Enum:AssetCredentialType:{(int)credential.CredentialType}"]</td>
                            <td>@credential.Username</td>
                            <td>
                                <span class="doc-no credential-value" data-credential-value="@credential.Id">&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;</span>
                                @if (Model.CanRevealCredentials)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-secondary credential-reveal-btn" data-credential-id="@credential.Id">@L["Reveal"]</button>
                                }
                            </td>
                            <td>@credential.Notes</td>
                            <td>
                                @if (Model.CanEdit)
                                {
                                    <form method="post" asp-page-handler="DeleteCredential" asp-route-credentialId="@credential.Id" class="d-inline" onsubmit="return confirm('@L["AreYouSureToDelete"]');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">@L["Delete"]</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h5 class="card-title mb-0">@L["Relationships"]</h5>
    </div>
    <div class="card-body">
        @if (Model.CanEdit)
        {
            <form method="post" asp-page-handler="AddRelationship" class="row g-2 mb-3 align-items-end">
                <div class="col-md-5">
                    <label class="form-label">@L["ConfigurationItem"]</label>
                    <select asp-for="NewRelationship.TargetCiId" asp-items="Model.TargetCiOptions" class="form-select">
                        <option value="">@L["Select"]</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">@L["RelationshipType"]</label>
                    <select asp-for="NewRelationship.RelationshipType" class="form-select">
                        <option value="0">@L["Enum:ConfigurationItemRelationshipType:0"]</option>
                        <option value="1">@L["Enum:ConfigurationItemRelationshipType:1"]</option>
                        <option value="2">@L["Enum:ConfigurationItemRelationshipType:2"]</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-primary">@L["AddRelationship"]</button>
                </div>
            </form>
        }
        <div class="table-responsive">
            <table class="table table-sm mb-0">
                <thead>
                    <tr><th>@L["RelationshipType"]</th><th>@L["ConfigurationItem"]</th><th>@L["Actions"]</th></tr>
                </thead>
                <tbody>
                    @if (!Model.Relationships.Any())
                    {
                        <tr class="table-empty-state"><td colspan="3">@L["NoResultsFound"]</td></tr>
                    }
                    @foreach (var relationship in Model.Relationships)
                    {
                        <tr>
                            <td>@L[$"Enum:ConfigurationItemRelationshipType:{(int)relationship.RelationshipType}"]</td>
                            <td><a asp-page="./Detail" asp-route-id="@relationship.TargetCiId">@relationship.TargetCiName</a></td>
                            <td>
                                @if (Model.CanEdit)
                                {
                                    <form method="post" asp-page-handler="DeleteRelationship" asp-route-relationshipId="@relationship.Id" class="d-inline" onsubmit="return confirm('@L["AreYouSureToDelete"]');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">@L["Delete"]</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            // Each click re-fetches (and re-logs, server-side) rather than caching after the first
            // reveal - the audit trail is meant to record every time someone actually looked at a
            // stored value, not just the first.
            document.querySelectorAll('.credential-reveal-btn').forEach(function (btn) {
                btn.addEventListener('click', async function () {
                    var id = btn.getAttribute('data-credential-id');
                    var valueSpan = document.querySelector('.credential-value[data-credential-value="' + id + '"]');
                    if (!valueSpan) {
                        return;
                    }

                    try {
                        var response = await fetch('?handler=RevealCredential&credentialId=' + id);
                        if (!response.ok) {
                            return;
                        }
                        var result = await response.json();
                        valueSpan.textContent = result.value;
                        btn.remove();
                    } catch (error) {
                        console.error('Error revealing credential:', error);
                    }
                });
            });
        })();
    </script>
}
