@page
@using Leitor.Erp.Pages.Shared.Components.BrandingStyle
@using Microsoft.AspNetCore.Mvc.Localization
@using Volo.Abp.Account.Localization
@using Volo.Abp.Account.Web.Pages.Account;
@using Volo.Abp.AspNetCore.Mvc.UI.Theming;
@using Volo.Abp.Identity;
@using Volo.Abp.Ui.Branding;
@model Volo.Abp.Account.Web.Pages.Account.LoginModel
@inject IHtmlLocalizer<AccountResource> L
@inject IThemeManager ThemeManager
@inject IBrandingProvider BrandingProvider

@{
    Layout = ThemeManager.CurrentTheme.GetAccountLayout();
}

@section styles
{
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap">
    <link rel="stylesheet" href="/leitor-tokens.css" />
    <link rel="stylesheet" href="/leitor-theme.css" />
    <link rel="stylesheet" href="/Pages/Account/login.css" />

    <!-- Settings-driven logo/favicon (see Components/BrandingStyle) - invoked directly rather
         than via LayoutHooks, since the Account layout is excluded from those (see
         ErpModule.ConfigureLayoutHooks's own comment). Rendered after the stylesheets above so
         its --lpx-logo/--lpx-logo-icon override wins by source order. -->
    @await Component.InvokeAsync(typeof(BrandingStyleViewComponent))

    <!-- A first-time mobile visitor's very first page IS this login screen, so the install
         prompt (wwwroot/leitor-pwa.js) needs to be eligible here too - see PwaHeadViewComponent's
         own comment for why the Account layout can't just pick these up via LayoutHooks. -->
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#f59e0b" />
    <link rel="apple-touch-icon" href="/images/pwa/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="@BrandingProvider.AppName" />
}

@section scripts
{
    <abp-script-bundle name="@typeof(LoginModel).FullName">
        <abp-script src="/Pages/Account/login.js" />
        <abp-script src="/leitor-pwa.js" />
    </abp-script-bundle>
}

<div class="leitor-auth-container">
    <div class="leitor-auth-ring leitor-auth-ring--lg" aria-hidden="true"></div>
    <div class="leitor-auth-ring leitor-auth-ring--sm" aria-hidden="true"></div>
    <div class="leitor-auth-wrapper">

        @if (Model.ShowRequireMigrateSeedMessage)
        {
            <div class="alert alert-danger mb-3">
                <h4 class="alert-heading">@L["RequireMigrateSeedTitle"]</h4>
                <p class="mb-0">@L["RequireMigrateSeedMessage"]</p>
            </div>
        }

        <div class="card">
            <div class="card-body">

                <!-- Single-panel login: logo + app name live inside this same card instead of the
                     theme's own separate logo/title-bar panels above it (hidden via CSS, see
                     login.css - LeptonXLite's Account layout is precompiled with no safe direct
                     override, see ErpModule.ConfigureLayoutHooks's own comment). --lpx-logo-icon
                     is the same CSS var the theme's header/sidebar already read, kept in sync by
                     Components/BrandingStyle above. -->
                <div class="leitor-auth-brand">
                    <div class="lpx-brand-logo leitor-auth-logo" aria-hidden="true"></div>
                    <div class="leitor-auth-appname">@BrandingProvider.AppName</div>
                </div>

                <!-- Main Login Form -->
                @if (Model.EnableLocalLogin)
                {
                    <form method="post">

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger leitor-validation-summary"></div>

                        <!-- Email/Username Field -->
                        <div class="mb-3">
                            <label asp-for="LoginInput.UserNameOrEmailAddress" class="form-label">
                                @L["EmailOrUsername"]
                            </label>
                            <input
                                asp-for="LoginInput.UserNameOrEmailAddress"
                                class="form-control"
                                placeholder="name@company.com"
                                autocomplete="username"
                                autofocus="autofocus"
                            />
                            <span asp-validation-for="LoginInput.UserNameOrEmailAddress" class="text-danger small"></span>
                        </div>

                        <!-- Password Field with Toggle -->
                        <div class="mb-3">
                            <div class="leitor-form-label-wrapper">
                                <label asp-for="LoginInput.Password" class="form-label">
                                    @L["Password"]
                                </label>
                                <a href="@Url.Page("./ForgotPassword", new { returnUrl = Model.ReturnUrl, returnUrlHash = Model.ReturnUrlHash })" class="small">
                                    @L["ForgotPassword"]
                                </a>
                            </div>
                            <div class="leitor-password-wrapper">
                                <input
                                    type="password"
                                    class="form-control"
                                    autocomplete="current-password"
                                    maxlength="@IdentityUserConsts.MaxPasswordLength"
                                    asp-for="LoginInput.Password"
                                    placeholder="@L["EnterPassword"]"
                                />
                                <button
                                    type="button"
                                    class="leitor-password-toggle"
                                    id="PasswordVisibilityButton"
                                    title="@L["TogglePasswordVisibility"]"
                                    aria-label="@L["TogglePasswordVisibility"]"
                                >
                                    <i class="fa fa-eye-slash"></i>
                                </button>
                            </div>
                            <span asp-validation-for="LoginInput.Password" class="text-danger small"></span>
                        </div>

                        <!-- Remember Me Checkbox -->
                        <div class="form-check mb-3">
                            <input type="checkbox" asp-for="LoginInput.RememberMe" id="RememberMe" class="form-check-input" />
                            <label for="RememberMe" class="form-check-label">
                                @L["RememberMe"]
                            </label>
                        </div>

                        <!-- Sign In Button -->
                        <button type="submit" class="btn btn-primary w-100 mb-2">
                            @L["Login"]
                        </button>

                        <!-- Cancel Button (if needed) -->
                        @if (Model.ShowCancelButton)
                        {
                            <button type="submit" class="btn btn-secondary w-100" formnovalidate="formnovalidate" name="Action" value="Cancel">
                                @L["Cancel"]
                            </button>
                        }
                    </form>
                }

                <!-- Error Message (no schemes configured) -->
                @if (!Model.EnableLocalLogin && !Model.VisibleExternalProviders.Any())
                {
                    <div class="alert alert-warning">
                        <strong>@L["InvalidLoginRequest"]</strong>
                        @L["ThereAreNoLoginSchemesConfiguredForThisClient"]
                    </div>
                }
            </div>
        </div>
    </div>
</div>
