@page "{id}"
@using Microsoft.AspNetCore.Mvc.Localization
@using Leitor.Erp.Localization
@using Leitor.Erp.Entities.Opportunities
@using Leitor.Erp.Entities.Partners
@inject IHtmlLocalizer<ErpResource> L
@model Leitor.Erp.Pages.Opportunities.DetailModel

<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="card-title mb-0">@Model.Opportunity.Name</h5>
        <div>
            @if (Model.CanEdit)
            {
                <a asp-page="./Edit" asp-route-id="@Model.Opportunity.Id" class="btn btn-outline-primary" data-overlay data-overlay-title="@L["EditOpportunity"]">@L["Edit"]</a>
            }
            @if (Model.CanSharePackage)
            {
                <form method="post" asp-page-handler="SharePackage" asp-route-id="@Model.Opportunity.Id" class="d-inline" data-confirm="@L["SharePackage"]?">
                    <button type="submit" class="btn btn-outline-success">@L["SharePackage"]</button>
                </form>
            }
            <a asp-page="./Index" class="btn btn-secondary">@L["BackToList"]</a>
        </div>
    </div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-2">@L["Customer"]</dt>
            <dd class="col-sm-4">@Model.Opportunity.CustomerName</dd>
            <dt class="col-sm-2">@L["Status"]</dt>
            <dd class="col-sm-4"><span class="pill @StatusPill.For(Model.Opportunity.Status)">@L[$"Enum:OpportunityStatus:{(int)Model.Opportunity.Status}"]</span></dd>

            <dt class="col-sm-2">@L["EstimatedValue"]</dt>
            <dd class="col-sm-4">@Model.Opportunity.EstimatedValue?.ToString("N2")</dd>
            <dt class="col-sm-2">@L["ExpectedCloseDate"]</dt>
            <dd class="col-sm-4">@(Model.Opportunity.ExpectedCloseDate?.ToShortDateString())</dd>

            <dt class="col-sm-2">@L["AssignedTo"]</dt>
            <dd class="col-sm-4">@Model.Opportunity.AssignedToUserName</dd>

            @if (!string.IsNullOrWhiteSpace(Model.Opportunity.LeadDisplayName))
            {
                <dt class="col-sm-2">@L["FromLead"]</dt>
                <dd class="col-sm-4">@Model.Opportunity.LeadDisplayName</dd>
            }

            @if (Model.ShowPartnerCommission && (!string.IsNullOrWhiteSpace(Model.Opportunity.PartnerName) || !string.IsNullOrWhiteSpace(Model.Opportunity.AgentName)))
            {
                <dt class="col-sm-2">@L["Partner"]</dt>
                <dd class="col-sm-4">@Model.Opportunity.PartnerName</dd>
                <dt class="col-sm-2">@L["Agent"]</dt>
                <dd class="col-sm-4">@Model.Opportunity.AgentName</dd>
            }

            @if (!string.IsNullOrWhiteSpace(Model.Opportunity.LostReason))
            {
                <dt class="col-sm-2">@L["LostReason"]</dt>
                <dd class="col-sm-10">@Model.Opportunity.LostReason</dd>
            }

            @if (!string.IsNullOrWhiteSpace(Model.Opportunity.Notes))
            {
                <dt class="col-sm-2">@L["Notes"]</dt>
                <dd class="col-sm-10">@Model.Opportunity.Notes</dd>
            }
        </dl>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="card-title mb-0">@L["NeedsAssessments"]</h5>
        <a asp-page="/Opportunities/Assessments/Create" asp-route-opportunityId="@Model.Opportunity.Id" class="btn btn-primary btn-sm" data-overlay data-overlay-title="@L["NewAssessment"]">@L["NewAssessment"]</a>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>@L["Type"]</th>
                        <th>@L["ConductedDate"]</th>
                        <th>@L["ConductedBy"]</th>
                        <th>@L["Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var assessment in Model.Assessments)
                    {
                        <tr>
                            <td>@L[$"Enum:NeedsAssessmentType:{(int)assessment.Type}"]</td>
                            <td>@assessment.ConductedDate.ToShortDateString()</td>
                            <td>@assessment.ConductedByUserName</td>
                            <td>
                                <a asp-page="/Opportunities/Assessments/Edit" asp-route-id="@assessment.Id" asp-route-opportunityId="@Model.Opportunity.Id" class="btn btn-sm btn-outline-primary">@L["Edit"]</a>
                                <form method="post" asp-page-handler="DeleteAssessment" asp-route-assessmentId="@assessment.Id" class="d-inline" data-confirm="@L["AreYouSureToDelete"]" data-confirm-variant="danger">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">@L["Delete"]</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="card-title mb-0">@L["Proposals"]</h5>
        <a asp-page="/Opportunities/Proposals/Create" asp-route-opportunityId="@Model.Opportunity.Id" class="btn btn-primary btn-sm" data-overlay data-overlay-title="@L["NewProposal"]">@L["NewProposal"]</a>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>@L["ProposalNumber"]</th>
                        <th>@L["Title"]</th>
                        <th>@L["Status"]</th>
                        <th>@L["Version"]</th>
                        <th>@L["Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var proposal in Model.Proposals)
                    {
                        <tr>
                            <td class="doc-no">@proposal.ProposalNumber</td>
                            <td>
                                @proposal.Title
                                @if (proposal.Status == ProposalStatus.Superseded && !string.IsNullOrWhiteSpace(proposal.SupersededReason))
                                {
                                    <br /><small class="text-muted">@L["SupersededReason"]: @proposal.SupersededReason</small>
                                }
                            </td>
                            <td><span class="pill @StatusPill.For(proposal.Status)">@L[$"Enum:ProposalStatus:{(int)proposal.Status}"]</span></td>
                            <td>@proposal.Version</td>
                            <td>
                                <a asp-page="/Opportunities/Proposals/Edit" asp-route-id="@proposal.Id" asp-route-opportunityId="@Model.Opportunity.Id" class="btn btn-sm btn-outline-primary">@L["Edit"]</a>
                                <a asp-page="/Opportunities/Proposals/Edit" asp-page-handler="Pdf" asp-route-id="@proposal.Id" asp-route-opportunityId="@Model.Opportunity.Id" class="btn btn-sm btn-outline-secondary">@L["DownloadPdf"]</a>
                                @if (Model.CanEdit && Model.CanConvertProposal(proposal))
                                {
                                    <form method="post" asp-page-handler="ConvertToQuote" asp-route-proposalId="@proposal.Id" class="d-inline" data-confirm="@L["ConvertToQuote"]?">
                                        <button type="submit" class="btn btn-sm btn-success">@L["ConvertToQuote"]</button>
                                    </form>
                                }
                                else if (Model.QuoteIdByProposalId.TryGetValue(proposal.Id, out var existingQuoteId))
                                {
                                    <a asp-page="/Sales/Quotes/Detail" asp-route-id="@existingQuoteId" class="btn btn-sm btn-outline-success">@L["Quote"]</a>
                                }
                                @if (Model.CanEdit && Model.CanSupersedeProposal(proposal))
                                {
                                    <form method="post" asp-page-handler="SupersedeProposal" asp-route-proposalId="@proposal.Id" class="d-inline" onsubmit="return promptSupersedeReason(this);">
                                        <input type="hidden" name="supersedeReason" class="supersede-reason-input" />
                                        <button type="submit" class="btn btn-sm btn-outline-warning">@L["Supersede"]</button>
                                    </form>
                                }
                                @if (proposal.Status == ProposalStatus.Superseded)
                                {
                                    @if (Model.ReplacementProposalIdBySupersededId.TryGetValue(proposal.Id, out var replacementId))
                                    {
                                        <a asp-page="/Opportunities/Proposals/Edit" asp-route-id="@replacementId" asp-route-opportunityId="@Model.Opportunity.Id" class="btn btn-sm btn-outline-success">@L["Replaces"]</a>
                                    }
                                    else if (Model.CanEdit)
                                    {
                                        <a asp-page="/Opportunities/Proposals/Create" asp-route-opportunityId="@Model.Opportunity.Id" asp-route-supersedesProposalId="@proposal.Id" class="btn btn-sm btn-success" data-overlay data-overlay-title="@L["NewProposal"]">@L["CreateReplacement"]</a>
                                    }
                                }
                                <form method="post" asp-page-handler="DeleteProposal" asp-route-proposalId="@proposal.Id" class="d-inline" data-confirm="@L["AreYouSureToDelete"]" data-confirm-variant="danger">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">@L["Delete"]</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (Model.ShowPartnerCommission)
{
    <div class="card mt-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0">@L["Commissions"]</h5>
            <a asp-page="/Commissions/Create" asp-route-opportunityId="@Model.Opportunity.Id" class="btn btn-primary btn-sm" data-overlay data-overlay-title="@L["NewCommission"]">@L["NewCommission"]</a>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>@L["Partner"]</th>
                            <th>@L["Agent"]</th>
                            <th>@L["Basis"]</th>
                            <th>@L["Amount"]</th>
                            <th>@L["Trigger"]</th>
                            <th>@L["Status"]</th>
                            <th>@L["Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Commissions.Any())
                        {
                            <tr class="table-empty-state"><td colspan="7">@L["NoResultsFound"]</td></tr>
                        }
                        @foreach (var commission in Model.Commissions)
                        {
                            <tr>
                                <td>@commission.PartnerName</td>
                                <td>@commission.AgentName</td>
                                <td>@L[$"Enum:CommissionBasis:{(int)commission.Basis}"]</td>
                                <td>@commission.Amount.ToString("N2")</td>
                                <td>@L[$"Enum:CommissionTrigger:{(int)commission.Trigger}"]</td>
                                <td><span class="pill @StatusPill.For(commission.Status)">@L[$"Enum:CommissionStatus:{(int)commission.Status}"]</span></td>
                                <td>
                                    @if (Model.CanEdit && commission.Status == CommissionStatus.Payable)
                                    {
                                        <form method="post" asp-page-handler="MarkCommissionPaid" asp-route-commissionId="@commission.Id" class="d-inline" data-confirm="@L["MarkPaid"]?">
                                            <button type="submit" class="btn btn-sm btn-success">@L["MarkPaid"]</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        // Supersede requires a reason (enforced server-side too) - a plain prompt() keeps this
        // page free of a modal library for one occasional action, same tradeoff as the existing
        // confirm()-based delete/convert buttons on this page.
        function promptSupersedeReason(form) {
            var reason = prompt('@L["SupersedeReasonPrompt"]');
            if (!reason) {
                return false;
            }
            form.querySelector('.supersede-reason-input').value = reason;
            return true;
        }
    </script>
}
