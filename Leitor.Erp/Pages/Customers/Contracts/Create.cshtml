@page "{customerId}"
@using Microsoft.AspNetCore.Mvc.Localization
@using Leitor.Erp.Localization
@using Leitor.Erp.Entities.Customers
@inject IHtmlLocalizer<ErpResource> L
@model Leitor.Erp.Pages.Customers.Contracts.CreateModel

<div class="card">
    <div class="card-header">
        <h5 class="card-title mb-0">@L["NewContract"]</h5>
    </div>
    <div class="card-body">
        <form method="post">
            <input type="hidden" asp-for="Contract.CustomerId" value="@Model.CustomerId" />
            <input type="hidden" asp-for="FromProjectId" />
            <div asp-validation-summary="All" class="text-danger"></div>
            <abp-input asp-for="Contract.ContractNumber" />
            <abp-input asp-for="Contract.Title" />
            <abp-input asp-for="Contract.Type" />
            <abp-input asp-for="Contract.Status" />
            <abp-input asp-for="Contract.StartDate" />
            <abp-input asp-for="Contract.EndDate" />
            <abp-input asp-for="Contract.Value" />
            <abp-input asp-for="Contract.Notes" />

            <div class="row">
                <div class="col-md-6">
                    <label class="form-label">@L["ContractTemplate"]</label>
                    <select asp-for="Contract.ContractTemplateId" asp-items="Model.ContractTemplateOptions" class="form-select"></select>
                </div>
                <div class="col-md-6"><abp-input asp-for="Contract.ClientSignatoryName" /></div>
            </div>

            <h6 class="mt-3">@L["SlaSectionTitle"]</h6>
            <p class="text-muted small">@L["SlaSectionHint"]</p>
            <div class="row">
                <div class="col-md-3"><abp-input asp-for="Contract.SlaUrgentHours" /></div>
                <div class="col-md-3"><abp-input asp-for="Contract.SlaHighHours" /></div>
                <div class="col-md-3"><abp-input asp-for="Contract.SlaMediumHours" /></div>
                <div class="col-md-3"><abp-input asp-for="Contract.SlaLowHours" /></div>
            </div>

            <h6 class="mt-3">@L["ServicesIncluded"]</h6>
            <p class="text-muted small">@L["ServicesIncludedHint"]</p>
            <div class="row">
                @foreach (var flag in ContractServiceScopeOptions.All)
                {
                    <div class="col-md-4 form-check">
                        <input type="checkbox" class="form-check-input" name="SelectedServiceFlags" value="@((int)flag)" id="svc-@((int)flag)" />
                        <label class="form-check-label" for="svc-@((int)flag)">@L[$"Enum:ContractServiceScope:{flag}"]</label>
                    </div>
                }
            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-primary">@L["Save"]</button>
                <a asp-page="/Customers/Detail" asp-route-id="@Model.CustomerId" class="btn btn-secondary">@L["Cancel"]</a>
            </div>
        </form>
    </div>
</div>
