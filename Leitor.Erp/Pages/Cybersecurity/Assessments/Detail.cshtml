@page "{id}"
@using Microsoft.AspNetCore.Mvc.Localization
@using Leitor.Erp.Localization
@using Leitor.Erp.Entities.Cybersecurity
@inject IHtmlLocalizer<ErpResource> L
@model Leitor.Erp.Pages.Cybersecurity.Assessments.DetailModel

@{
    var isCompleted = Model.Assessment.Status == SecurityAssessmentStatus.Completed;
}

<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="card-title mb-0"><span class="doc-no">@Model.Assessment.AssessmentNumber</span> - @Model.Assessment.Title</h5>
        <div>
            @if (Model.CanEdit)
            {
                <a asp-page="./Edit" asp-route-id="@Model.Assessment.Id" class="btn btn-outline-primary">@L["Edit"]</a>
                @if (!isCompleted)
                {
                    @if (Model.Assessment.Status != SecurityAssessmentStatus.InProgress)
                    {
                        <form method="post" asp-page-handler="SetStatus" asp-route-status="1" class="d-inline">
                            <button type="submit" class="btn btn-secondary">@L["Enum:SecurityAssessmentStatus:1"]</button>
                        </form>
                    }
                    <form method="post" asp-page-handler="SetStatus" asp-route-status="2" class="d-inline">
                        <button type="submit" class="btn btn-success">@L["Enum:SecurityAssessmentStatus:2"]</button>
                    </form>
                }
                else
                {
                    <form method="post" asp-page-handler="SetStatus" asp-route-status="0" class="d-inline">
                        <button type="submit" class="btn btn-secondary">@L["Reopen"]</button>
                    </form>
                }
            }
            <a asp-page="./Index" class="btn btn-secondary">@L["BackToList"]</a>
        </div>
    </div>
    <div class="card-body">
        <partial name="/Pages/Shared/_PendingDeletionBanner.cshtml" model="Model.HasPendingDeletionRequest" />
        <dl class="row mb-0">
            <dt class="col-sm-2">@L["Customer"]</dt>
            <dd class="col-sm-4"><a asp-page="/Customers/Detail" asp-route-id="@Model.Assessment.CustomerId">@Model.Assessment.CustomerName</a></dd>
            <dt class="col-sm-2">@L["Type"]</dt>
            <dd class="col-sm-4">@L[$"Enum:SecurityAssessmentType:{(int)Model.Assessment.Type}"]</dd>

            <dt class="col-sm-2">@L["Status"]</dt>
            <dd class="col-sm-4"><span class="pill @StatusPill.For(Model.Assessment.Status)">@L[$"Enum:SecurityAssessmentStatus:{(int)Model.Assessment.Status}"]</span></dd>
            <dt class="col-sm-2">@L["RiskRating"]</dt>
            <dd class="col-sm-4">
                @if (Model.Assessment.RiskRating.HasValue)
                {
                    <span class="pill @StatusPill.For(Model.Assessment.RiskRating.Value)">@L[$"Enum:SecurityRiskRating:{(int)Model.Assessment.RiskRating.Value}"]</span>
                }
            </dd>

            <dt class="col-sm-2">@L["ScheduledDate"]</dt>
            <dd class="col-sm-4">@Model.Assessment.ScheduledDate.ToShortDateString()</dd>
            <dt class="col-sm-2">@L["CompletedDate"]</dt>
            <dd class="col-sm-4">@(Model.Assessment.CompletedDate?.ToShortDateString())</dd>

            @if (!string.IsNullOrWhiteSpace(Model.Assessment.ConductedByUserName))
            {
                <dt class="col-sm-2">@L["ConductedBy"]</dt>
                <dd class="col-sm-4">@Model.Assessment.ConductedByUserName</dd>
            }

            @if (Model.Assessment.FollowUpDate.HasValue)
            {
                <dt class="col-sm-2">@L["FollowUpDate"]</dt>
                <dd class="col-sm-4">@Model.Assessment.FollowUpDate.Value.ToShortDateString()</dd>
            }

            @if (!string.IsNullOrWhiteSpace(Model.Assessment.Findings))
            {
                <dt class="col-sm-2">@L["Findings"]</dt>
                <dd class="col-sm-10">@Model.Assessment.Findings</dd>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Assessment.Recommendations))
            {
                <dt class="col-sm-2">@L["Recommendations"]</dt>
                <dd class="col-sm-10">@Model.Assessment.Recommendations</dd>
            }
        </dl>
    </div>
</div>
