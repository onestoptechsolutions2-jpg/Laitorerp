@page "{id}"
@using Microsoft.AspNetCore.Mvc.Localization
@using Leitor.Erp.Localization
@inject IHtmlLocalizer<ErpResource> L
@model Leitor.Erp.Pages.Partners.EditModel
@{
    if (OverlayRequest.Is(Request)) { Layout = null; }
}

<div class="card">
    <div class="card-header">
        <h5 class="card-title mb-0">@L["EditPartner"]</h5>
    </div>
    <div class="card-body">
        <form method="post">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="All" class="text-danger"></div>
            <abp-input asp-for="Partner.Name" />
            <abp-input asp-for="Partner.Category" />
            <abp-input asp-for="Partner.Email" />
            <abp-input asp-for="Partner.Phone" />
            <abp-input asp-for="Partner.CommissionBasis" />
            <abp-input asp-for="Partner.CommissionRate" />
            <abp-input asp-for="Partner.CommissionTrigger" />
            <abp-input asp-for="Partner.Notes" />

            <div class="mt-3">
                <button type="submit" class="btn btn-primary">@L["Save"]</button>
                <a asp-page="./Index" class="btn btn-secondary">@L["Cancel"]</a>
            </div>
        </form>
    </div>
</div>
