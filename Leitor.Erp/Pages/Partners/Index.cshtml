@page
@using Microsoft.AspNetCore.Mvc.Localization
@using Leitor.Erp.Localization
@inject IHtmlLocalizer<ErpResource> L
@model Leitor.Erp.Pages.Partners.IndexModel

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="card-title mb-0">@L["Partners"]</h5>
        @if (Model.CanCreate)
        {
            <a asp-page="./Create" class="btn btn-primary" data-overlay data-overlay-title="@L["NewPartner"]">@L["NewPartner"]</a>
        }
    </div>
    <div class="card-body">
        <form method="get" class="row g-2 mb-3">
            <div class="col-auto">
                <input type="text" class="form-control" name="Filter" value="@Model.Filter" placeholder="@L["Name"]" />
            </div>
            <div class="col-auto">
                <select class="form-select" name="IsActive">
                    <option value="">@L["Status"]: @L["None"]</option>
                    <option value="true" selected="@(Model.IsActive == true)">@L["Active"]</option>
                    <option value="false" selected="@(Model.IsActive == false)">@L["Inactive"]</option>
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-secondary">@L["Search"]</button>
            </div>
        </form>
        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>@L["Name"]</th>
                        <th>@L["Category"]</th>
                        <th>@L["CommissionBasis"]</th>
                        <th>@L["CommissionRate"]</th>
                        <th>@L["Status"]</th>
                        <th>@L["Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Items.Any())
                    {
                        <tr class="table-empty-state">
                            <td colspan="6">
                                <div>@L["NoResultsFound"]</div>
                                @if (Model.CanCreate)
                                {
                                    <a asp-page="./Create" class="btn btn-sm btn-outline-primary mt-2" data-overlay data-overlay-title="@L["NewPartner"]">@L["NewPartner"]</a>
                                }
                            </td>
                        </tr>
                    }
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@item.Name</td>
                            <td>@L[$"Enum:PartnerCategory:{(int)item.Category}"]</td>
                            <td>@L[$"Enum:CommissionBasis:{(int)item.CommissionBasis}"]</td>
                            <td>@item.CommissionRate.ToString("N2")</td>
                            <td><span class="pill @(item.IsActive ? "pill-success" : "pill-neutral")">@(item.IsActive ? L["Active"] : L["Inactive"])</span></td>
                            <td>
                                <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" data-overlay data-overlay-title="@L["EditPartner"]">@L["Edit"]</a>
                                @if (Model.CanDelete)
                                {
                                    <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id" asp-route-Filter="@Model.Filter" class="d-inline" data-confirm="@L["AreYouSureToDelete"]" data-confirm-variant="danger">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">@L["Delete"]</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="/Pages/Shared/_Pagination.cshtml" model="Model.Pagination" />
    </div>
</div>
