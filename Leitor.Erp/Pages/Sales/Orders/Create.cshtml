@page
@using Microsoft.AspNetCore.Mvc.Localization
@using Leitor.Erp.Localization
@inject IHtmlLocalizer<ErpResource> L
@model Leitor.Erp.Pages.Sales.Orders.CreateModel

<partial name="/Pages/Shared/_OrderStepper.cshtml" model="Leitor.Erp.Pages.Shared.OrderWizardStep.Customer" />

<div class="card">
    <div class="card-header">
        <h5 class="card-title mb-0">@L["NewOrder"]</h5>
    </div>
    <div class="card-body">
        <form method="post">
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="mb-3">
                <label class="form-label">@L["Customer"]</label>
                <div class="input-group">
                    <select asp-for="Order.CustomerId" asp-items="Model.CustomerOptions" class="form-select"></select>
                    <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#newCustomerModal" title="Create new customer">
                        <i class="fa fa-plus"></i>
                    </button>
                </div>
            </div>
            <abp-input asp-for="Order.Status" />
            <abp-input asp-for="Order.OrderDate" />
            <abp-input asp-for="Order.PaymentTerms" />
            <abp-select asp-for="Order.CurrencyCode" asp-items="Model.CurrencyOptions" label="@L["Currency"].Value" />
            <abp-select asp-for="Order.WarehouseId" asp-items="Model.WarehouseOptions" label="@L["Warehouse"].Value" />
            @if (Model.CanUseProjects)
            {
                <abp-select asp-for="Order.ProjectId" asp-items="Model.ProjectOptions" label="@L["Project"].Value" />
            }
            <abp-input asp-for="Order.Notes" />

            <div class="mt-3">
                <button type="submit" class="btn btn-primary">@L["ContinueToItems"]</button>
                <a asp-page="./Index" class="btn btn-secondary">@L["Cancel"]</a>
            </div>
        </form>
    </div>
</div>

<!-- New Customer Modal -->
<div class="modal fade" id="newCustomerModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@L["CreateNewCustomer"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="newCustomerForm" method="post" asp-page-handler="CreateCustomer">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">@L["Name"]</label>
                        <input type="text" class="form-control" name="name" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@L["Email"]</label>
                        <input type="email" class="form-control" name="email" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@L["Phone"]</label>
                        <input type="text" class="form-control" name="phone" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@L["Cancel"]</button>
                    <button type="submit" class="btn btn-primary">@L["CreateCustomer"]</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var customerCurrencies = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CustomerDefaultCurrencies));
            var customerSelect = document.getElementById('Order_CustomerId');
            var currencySelect = document.getElementById('Order_CurrencyCode');
            if (!customerSelect || !currencySelect) {
                return;
            }

            customerSelect.addEventListener('change', function () {
                var code = customerCurrencies[customerSelect.value];
                if (code) {
                    currencySelect.value = code;
                }
            });

            var newCustomerForm = document.getElementById('newCustomerForm');
            if (!newCustomerForm) {
                return;
            }

            newCustomerForm.addEventListener('submit', async function (e) {
                e.preventDefault();

                var formData = new FormData(this);
                var data = {
                    name: formData.get('name'),
                    email: formData.get('email') || null,
                    phone: formData.get('phone') || null
                };

                try {
                    var tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                    var headers = { 'Content-Type': 'application/json' };
                    if (tokenInput) {
                        headers['RequestVerificationToken'] = tokenInput.value;
                    }

                    var response = await fetch('?handler=CreateCustomer', {
                        method: 'POST',
                        headers: headers,
                        body: JSON.stringify(data)
                    });

                    if (response.ok) {
                        var result = await response.json();
                        bootstrap.Modal.getInstance(document.getElementById('newCustomerModal')).hide();

                        var option = document.createElement('option');
                        option.value = result.id;
                        option.textContent = result.name;
                        customerSelect.appendChild(option);

                        if (result.defaultCurrencyCode) {
                            customerCurrencies[result.id] = result.defaultCurrencyCode;
                        }

                        customerSelect.value = result.id;
                        customerSelect.dispatchEvent(new Event('change'));

                        newCustomerForm.reset();
                        alert('Customer created successfully');
                    } else {
                        var error = await response.json();
                        alert('Error creating customer: ' + (error.error || 'Unknown error'));
                    }
                } catch (error) {
                    alert('Error creating customer: ' + error.message);
                }
            });
        })();
    </script>
}
