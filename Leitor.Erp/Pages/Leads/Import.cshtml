@page
@using Microsoft.AspNetCore.Mvc.Localization
@using Leitor.Erp.Localization
@inject IHtmlLocalizer<ErpResource> L
@model Leitor.Erp.Pages.Leads.ImportModel

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="card-title mb-0">@L["ImportLeads"]</h5>
        <a asp-page="./Index" class="btn btn-secondary">@L["BackToList"]</a>
    </div>
    <div class="card-body">
        <p class="text-muted">@L["ImportLeadsFromFile"]</p>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger">@Model.ErrorMessage</div>
        }
        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div class="alert alert-success" style="white-space: pre-line">@Model.SuccessMessage</div>
        }

        <form method="post" enctype="multipart/form-data">
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="mb-3">
                <label class="form-label">@L["SelectFile"]</label>
                <input type="file" name="UploadedFile" accept=".xlsx" class="form-control" />
            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-primary">@L["ImportLeads"]</button>
            </div>
        </form>
    </div>
</div>
