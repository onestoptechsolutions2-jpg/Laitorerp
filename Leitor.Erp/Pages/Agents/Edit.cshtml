@page "{id}"
@using Microsoft.AspNetCore.Mvc.Localization
@using Leitor.Erp.Localization
@inject IHtmlLocalizer<ErpResource> L
@model Leitor.Erp.Pages.Agents.EditModel

<div class="card">
    <div class="card-header">
        <h5 class="card-title mb-0">@L["EditAgent"]</h5>
    </div>
    <div class="card-body">
        <form method="post">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="All" class="text-danger"></div>
            <abp-input asp-for="Agent.Name" />
            <abp-input asp-for="Agent.Email" />
            <abp-input asp-for="Agent.Phone" />
            <abp-input asp-for="Agent.Territory" />
            <abp-input asp-for="Agent.Skills" />
            <abp-input asp-for="Agent.CommissionBasis" />
            <abp-input asp-for="Agent.CommissionRate" />
            <abp-input asp-for="Agent.CommissionTrigger" />
            <abp-input asp-for="Agent.Notes" />

            <div class="mt-3">
                <button type="submit" class="btn btn-primary">@L["Save"]</button>
                <a asp-page="./Index" class="btn btn-secondary">@L["Cancel"]</a>
            </div>
        </form>
    </div>
</div>
