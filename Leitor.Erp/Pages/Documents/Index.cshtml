@page "/d/{token:guid}"
@using Microsoft.AspNetCore.Mvc.Localization
@using Leitor.Erp.Localization
@using Volo.Abp.AspNetCore.Mvc.UI.Theming
@inject IHtmlLocalizer<ErpResource> L
@inject IThemeManager ThemeManager
@model Leitor.Erp.Pages.Documents.IndexModel
@{
    // Same minimal, sidebar-free shell the Login page uses - a customer/vendor opening a shared
    // link must never see the internal staff app chrome (menu, action rail, global search).
    Layout = ThemeManager.CurrentTheme.GetAccountLayout();
}

<style>
    .leitor-doc-page {
        min-height: 70vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
    }
    .leitor-doc-card {
        max-width: 460px;
        width: 100%;
        background: #fffdf9;
        border: 1px solid #e7ddc9;
        border-radius: 14px;
        box-shadow: 0 8px 28px rgba(90, 40, 10, 0.08);
        padding: 36px 32px;
        text-align: center;
    }
    .leitor-doc-icon {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: #fef3e2;
        color: #b45309;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 18px;
        font-size: 24px;
    }
    .leitor-doc-company { font-size: 13px; letter-spacing: 0.04em; text-transform: uppercase; color: #9a8f78; margin-bottom: 6px; }
    .leitor-doc-title { font-size: 21px; font-weight: 700; color: #22282f; margin: 0 0 4px; }
    .leitor-doc-subtitle { font-size: 14px; color: #6b6455; margin: 0 0 24px; }
    .leitor-doc-download {
        display: inline-block;
        background: #b45309;
        color: #fff;
        text-decoration: none;
        font-weight: 600;
        font-size: 15px;
        padding: 12px 28px;
        border-radius: 8px;
    }
    .leitor-doc-download:hover { background: #92400e; color: #fff; }
    .leitor-doc-footnote { margin-top: 18px; font-size: 12px; color: #a39b88; }
</style>

<div class="leitor-doc-page">
    <div class="leitor-doc-card">
        @if (Model.LinkNotFound)
        {
            <div class="leitor-doc-icon">!</div>
            <p class="leitor-doc-title">@L["DocumentLinkNotFound"]</p>
            <p class="leitor-doc-subtitle">@L["DocumentLinkNotFoundDetail"]</p>
        }
        else
        {
            <div class="leitor-doc-icon">&#128196;</div>
            <p class="leitor-doc-company">@Model.CompanyName</p>
            <p class="leitor-doc-title">@Model.Title</p>
            @if (!string.IsNullOrWhiteSpace(Model.Subtitle))
            {
                <p class="leitor-doc-subtitle">@Model.Subtitle</p>
            }
            <a class="leitor-doc-download" asp-page-handler="Download" asp-route-token="@Model.Token">@L["DownloadPdf"]</a>
            <p class="leitor-doc-footnote">@L["DocumentLinkFootnote"]</p>
        }
    </div>
</div>
